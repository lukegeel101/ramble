#!/usr/bin/env python3
"""A stand-in for `claude -p`, so the tests need no Claude account.

FAKE_CLAUDE_MODE: echo (default) answers "CLEANED: <transcript>"; fail answers with an error result; hang never
answers; hang-first hangs on the first call and answers on later ones (FAKE_CLAUDE_COUNTER counts calls).
FAKE_CLAUDE_LOG, when set, gets one JSON line per call with the arguments; FAKE_CLAUDE_CWD_LOG gets the folder it ran in.
A text-mode call (the meaning check) prints FAKE_CLAUDE_MEANING, default {"issues": []}.
A call with an <inventory> (the coach) answers FAKE_CLAUDE_COACH, default {}, unless FAKE_CLAUDE_COACH_MODE=hang.
"""
import json
import os
import re
import sys
import time

args = sys.argv[1:]
if os.environ.get("CLAUDECODE"):  # like the real one, which refuses to start inside another Claude Code session
    print("Error: Claude Code cannot be launched inside another Claude Code session.", file=sys.stderr)
    sys.exit(1)
if os.environ.get("FAKE_CLAUDE_LOG"):
    with open(os.environ["FAKE_CLAUDE_LOG"], "a") as f:
        f.write(json.dumps(args) + "\n")
if os.environ.get("FAKE_CLAUDE_CWD_LOG"):
    with open(os.environ["FAKE_CLAUDE_CWD_LOG"], "a") as f:
        f.write(os.getcwd() + "\n")
mode = os.environ.get("FAKE_CLAUDE_MODE", "echo")
if mode == "hang-first":
    counter = os.environ["FAKE_CLAUDE_COUNTER"]
    n = int(open(counter).read() or 0) if os.path.exists(counter) else 0
    with open(counter, "w") as f:
        f.write(str(n + 1))
    mode = "hang" if n == 0 else "echo"
if mode == "hang":
    time.sleep(120)
    sys.exit(1)

if "stream-json" not in args:
    sys.stdin.read()
    print(os.environ.get("FAKE_CLAUDE_MEANING", '{"issues": []}'))
    sys.exit(0)

line = sys.stdin.readline()
content = json.loads(line)["message"]["content"]
transcript = re.search(r"<transcript>\n(.*)\n</transcript>", content, re.S).group(1)
print(json.dumps({"type": "system", "subtype": "init"}), flush=True)
if "<inventory>" in content:
    if os.environ.get("FAKE_CLAUDE_COACH_MODE") == "hang":
        time.sleep(120)
    print(json.dumps({"type": "result", "is_error": False, "result": os.environ.get("FAKE_CLAUDE_COACH", "{}")}), flush=True)
    sys.exit(0)
if mode == "fail":
    print(json.dumps({"type": "result", "is_error": True, "result": "API Error"}), flush=True)
else:
    print(json.dumps({"type": "result", "is_error": False, "result": "CLEANED: " + transcript}), flush=True)
